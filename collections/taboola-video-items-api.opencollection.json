{
  "opencollection": "1.0.0",
  "info": {
    "name": "Taboola Backstage Accounts Video Items API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Video Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Performance Video Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backstage.taboola.com/backstage/api/1.0/:account_id/campaigns/:campaign_id/video/items/",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "campaign_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a list of performance video items (motion ads) for the campaign."
        },
        {
          "info": {
            "name": "Create A Performance Video Item",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://backstage.taboola.com/backstage/api/1.0/:account_id/campaigns/:campaign_id/video/items/",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "campaign_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a performance video item (motion ad)."
        }
      ]
    }
  ],
  "bundled": true
}