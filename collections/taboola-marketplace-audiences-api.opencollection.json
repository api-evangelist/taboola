{
  "opencollection": "1.0.0",
  "info": {
    "name": "Taboola Backstage Accounts Marketplace Audiences API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Marketplace Audiences",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Marketplace Audiences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backstage.taboola.com/backstage/api/1.0/:account_id/dictionary/audience_segments",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a list of available Marketplace (third-party) Audiences for the account."
        }
      ]
    }
  ],
  "bundled": true
}