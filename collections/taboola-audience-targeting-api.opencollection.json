{
  "opencollection": "1.0.0",
  "info": {
    "name": "Taboola Backstage Accounts Audience Targeting API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audience Targeting",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get My Audience Targeting",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backstage.taboola.com/backstage/api/1.0/:account_id/campaigns/:campaign_id/targeting/my_audience",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "campaign_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get My Audience Targeting"
        },
        {
          "info": {
            "name": "Update My Audience Targeting",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://backstage.taboola.com/backstage/api/1.0/:account_id/campaigns/:campaign_id/targeting/my_audience",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "campaign_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update My Audience Targeting"
        }
      ]
    }
  ],
  "bundled": true
}